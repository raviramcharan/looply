{
  "name": "looply",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "concurrently -k \"node --watch server.mjs\" \"vite --host 0.0.0.0\"",
    "build": "tsc -b && vite build && node scripts/service-worker.mjs",
    "start": "node server.mjs",
    "test": "vitest run"
  },
  "dependencies": {
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "maplibre-gl": "6.12.0",
    "lucide-react": "1.52.0",
    "idb": "8.0.3",
    "zod": "4.6.5",
    "express": "5.2.1",
    "dotenv": "18.0.5",
    "saxes": "6.0.0"
  },
  "devDependencies": {
    "vite": "6.4.3",
    "typescript": "7.0.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/node": "26.6.4",
    "@types/express": "5.0.6",
    "@vitejs/plugin-react": "4.7.0",
    "vitest": "4.1.11",
    "jsdom": "27.0.1",
    "concurrently": "10.0.5"
  }
}
